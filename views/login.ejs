<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Guerra de Reinos</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="login-container">
        <div class="login-box">
            <h1>Guerra de Reinos</h1>
            
            <% if (error) { %> <div class="error"><%= error %></div> <% } %>
            <% if (success) { %> <div class="success"><%= success %></div> <% } %>

            <form action="/entrar" method="POST">
                <input type="text" name="usuario" placeholder="Nombre de Rey" required>
                <button type="submit" class="btn-login">Entrar al Reino</button>
            </form>

            <form action="/crear-rey" method="POST">
                <input type="text" name="usuario" placeholder="Nuevo Rey" required>
                <button type="submit" class="btn-register">Fundar Reino</button>
            </form>
            
            <a href="/generar-mapa">Reiniciar Continente (Admin)</a>
        </div>
    </div>
</body>
</html>
